    "lint": "eslint .",
    "format": "prettier -w .",
    "linkcheck": "node scripts/check-links.mjs",
    "audit:site": "node scripts/audit-site.mjs",
    "seo:check": "node scripts/seo-gate.mjs",
    "seo:production": "node scripts/production-check.mjs",
    "verify": "pnpm build && pnpm linkcheck && pnpm audit:site && pnpm seo:check && pnpm test && pnpm lint && pnpm check",
    "data:check": "node scripts/check-data-freshness.mjs"
  },
  "dependencies": {
    "@astrojs/mdx": "^4.3.0",
    "@astrojs/rss": "^4.0.12",
    "@astrojs/sitemap": "^3.4.1",
    "@tailwindcss/vite": "^4.1.11",
    "astro": "^5.12.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-slug": "^6.0.0",
    "sharp": "^0.33.5",
    "tailwindcss": "^4.1.11"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@typescript-eslint/parser": "^8.66.0",
    "eslint": "^9.30.0",
    "eslint-plugin-astro": "^1.3.1",
