---
/**
 * 专题页的品牌名单：按场景标签筛选并按每 GB 单价排序。
 * 每条附「入选理由」与「这条不适合谁」，避免变成无信息量的品牌堆砌。
 */
import { getCollection } from 'astro:content';
import VerifyStamp from './VerifyStamp.astro';

interface Props {
  /** 场景标签：ai / streaming / budget / iepl / newbie / longterm */
  scenario?: string;
  /** 指定 slug 顺序时优先使用 */
  slugs?: string[];
  limit?: number;
  /** 每个品牌在本专题下的入选理由（key = slug） */
  reasons?: Record<string, string>;
}
const { scenario, slugs, limit = 8, reasons = {} } = Astro.props;

const all = (await getCollection('brands')).filter((b) => b.data.priceFrom !== null);

let picked = slugs
  ? slugs.map((s) => all.find((b) => b.id === s)).filter((b) => b !== undefined)
  : all.filter((b) => (scenario ? b.data.scenarios.includes(scenario) : true));

if (!slugs) {
  picked = picked.sort((a, b) => (a.data.pricePerGb ?? 99) - (b.data.pricePerGb ?? 99));
}
picked = picked.slice(0, limit);
---

<div class="mt-6 grid gap-5 max-w-[54rem]">
  {
    picked.map((b, idx) => {
      const extUrl = b.data.affiliateUrl ?? b.data.officialUrl;
      return (
        <div class="pro-card p-5">
          <div class="flex flex-wrap items-center justify-between gap-3 border-b border-line pb-3.5">
            <div class="flex items-center gap-2.5">
              <span class="inline-flex items-center justify-center rounded-full bg-slate-100 text-slate-700 text-xs font-bold w-6 h-6 border border-slate-200">
                {idx + 1}
              </span>
              <h3 class="m-0 text-[1.2rem] font-bold">
                <a href={`/brands/${b.id}/`} class="text-ink hover:text-accent">
                  {b.data.name}
                </a>
              </h3>
              <VerifyStamp status="sourced" />
            </div>
            {b.data.priceFrom && (
              <div class="text-right">
                <span class="text-base font-bold text-accent">{b.data.priceFrom}</span>
                {b.data.pricePerGb && (
                  <span class="text-xs text-muted block">约 {b.data.pricePerGb.toFixed(3)} 元/GB</span>
                )}
              </div>
            )}
          </div>

          {reasons[b.id] && (
            <div class="mt-3.5 flex items-start gap-2 text-[0.93rem]">
              <span class="pro-tag-ok shrink-0 mt-0.5">✓ 场景匹配</span>
              <p class="m-0 text-ink leading-relaxed">{reasons[b.id]}</p>
            </div>
          )}

          <div class="mt-3.5 flex flex-wrap gap-2 text-xs">
            <span class="inline-flex items-center rounded-md bg-slate-50 px-2.5 py-1 text-slate-600 border border-slate-200">
              AI：{b.data.claims.ai ?? '未宣称'}
            </span>
            <span class="inline-flex items-center rounded-md bg-slate-50 px-2.5 py-1 text-slate-600 border border-slate-200">
              流媒体：{b.data.claims.streaming ?? '未宣称'}
            </span>
            {b.data.notSuitableFor[0] && (
              <span class="inline-flex items-center rounded-md bg-amber-50/60 px-2.5 py-1 text-amber-800 border border-amber-200/60">
                不适合：{b.data.notSuitableFor[0]}
              </span>
            )}
          </div>

          <div class="mt-4 flex flex-wrap items-center justify-between gap-3 border-t border-line pt-3.5">
            <div class="flex items-center gap-3 text-xs">
              {b.data.couponCode && (
                <span class="inline-flex items-center gap-1 rounded bg-amber-50 px-2 py-0.5 font-medium text-amber-800 border border-amber-200">
                  券码：<strong>{b.data.couponCode}</strong>
                </span>
              )}
              <a href={`/brands/${b.id}/`} class="text-muted hover:text-accent underline">
                技术档案 →
              </a>
            </div>

            <div class="flex items-center gap-2">
              {b.data.reviewSlug && (
                <a href={`/${b.data.reviewSlug}/`} class="btn-outline text-xs py-1.5 px-3 min-h-[36px]">
                  评测
                </a>
              )}
              {extUrl && (
                <a
                  href={extUrl}
                  class="btn-solid text-xs py-1.5 px-3 min-h-[36px]"
                  rel="nofollow sponsored noopener"
                  target="_blank"
                >
                  直达选购 ➔
                </a>
              )}
            </div>
          </div>
        </div>
      );
    })
  }
</div>
