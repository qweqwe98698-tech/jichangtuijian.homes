---
/**
 * 首页「先说结论」块 —— 答案前置。
 *
 * 为什么需要它：
 *   首页原本以「这里不先给你一份榜单」开场。对搜索「稳定机场」进来的用户，
 *   这句话等于说「你要的东西这里没有」，会造成退回搜索结果页（pogo-sticking）。
 *   本模块把结论提到最前，方法论退到其后——立场不变，只是顺序变了。
 *
 * 同时它是一个可被生成式引擎整段摘录的答案单元：
 *   固定锚点 id + 自足的结论句 + 具体数字 + 核对日期 + 明确的口径限定。
 *
 * 数据来源：全部由 brands 集合实时计算，不写死任何品牌名或数量，
 *   因此永远不会与 /best/stable/ 和 /brand-library/ 的数据行漂移。
 *
 * 三项代理指标的定义与 /best/stable/ 一致：
 *   1. 是否宣称 IEPL / IPLC 专线（严格口径：必须出现 IEPL 或 IPLC，
 *      「企业级内网专线」这类更模糊的说法不计入）
 *   2. 有无运营年限口径（launchYear 非空）
 *   3. 是否提供月付通道（billingCycle === 'monthly'）
 */
import { getCollection } from 'astro:content';
import { LAST_SITE_UPDATE } from '@/lib/site';

const brands = await getCollection('brands');

/** 严格口径：只认明确写出 IEPL / IPLC 的宣称 */
const claimsDedicatedLine = (b: (typeof brands)[number]) =>
  /IEPL|IPLC/i.test([...b.data.lineTypes, ...b.data.highlights].join(' '));

const scored = brands
  .filter((b) => b.data.priceFrom !== null)
  .map((b) => {
    const line = claimsDedicatedLine(b);
    const year = Boolean(b.data.launchYear && b.data.launchYear.trim() !== '');
    const monthly = b.data.billingCycle === 'monthly';
    return { b, line, year, monthly, hits: [line, year, monthly].filter(Boolean).length };
  });

/** 三项全中 */
const full = scored.filter((s) => s.hits === 3).sort((a, b) => a.b.data.name.localeCompare(b.b.data.name));

/** 只差年限口径的一档（专线 + 月付），按每 GB 单价升序，取前两家作代表 */
const nearly = scored
  .filter((s) => s.line && s.monthly && !s.year)
  .sort((a, b) => (a.b.data.pricePerGb ?? 99) - (b.b.data.pricePerGb ?? 99));

const nearlyShown = nearly.slice(0, 2);
const nearlyRest = nearly.length - nearlyShown.length;
const inLibrary = scored.length;
---

<section id="quick-answer" class="rule-top mt-10 pt-8" aria-labelledby="quick-answer-heading">
  <h2 id="quick-answer-heading" class="m-0 text-[0.95rem] tracking-widest text-muted">先说结论</h2>

  {/* 这一句要能脱离上下文独立成立——它是最可能被 AI 引擎整段摘走的部分 */}
  <p class="m-0 mt-4 max-w-[44rem] text-[1.08rem] leading-relaxed">
    稳定性是所有指标里<strong>唯一无法从公开资料推导</strong>的一项，所以本站不排「最稳第一名」。
    改用三项现在就能核对的代理指标筛候选：<strong>是否宣称 IEPL / IPLC 专线</strong>、
    <strong>有无运营年限口径</strong>、<strong>是否提供月付通道</strong>。
    在库 {inLibrary} 家里，三项都写明的只有 {full.length} 家。
  </p>

  <ol class="path-index mt-6 max-w-[50rem]">
    {
      full.map((s) => (
        <li>
          <div class="flex flex-wrap items-baseline justify-between gap-x-4">
            <h3 class="m-0 font-display text-[1.2rem]">
              <a href={`/brands/${s.b.id}/`} class="text-ink hover:text-accent">
                {s.b.data.name}
              </a>
            </h3>
            <p class="m-0 font-display text-[1.02rem] text-accent">{s.b.data.priceFrom}</p>
          </div>
          <p class="m-0 mt-2 text-[0.95rem]">
            三项代理指标都有明确口径：宣称 IEPL 专线、有运营年限说法、提供月付通道。
            月付意味着你可以先买一个月验证，通过了再谈续费。
          </p>
        </li>
      ))
    }

    {
      nearlyShown.map((s) => (
        <li>
          <div class="flex flex-wrap items-baseline justify-between gap-x-4">
            <h3 class="m-0 font-display text-[1.15rem]">
              <a href={`/brands/${s.b.id}/`} class="text-ink hover:text-accent">
                {s.b.data.name}
              </a>
            </h3>
            <p class="m-0 font-display text-[1.02rem] text-muted">{s.b.data.priceFrom}</p>
          </div>
          <p class="m-0 mt-2 text-[0.95rem] text-muted">
            满足专线与月付两项，未提供运营年限口径
            {s.b.data.pricePerGb !== null && <> · 每 GB 约 {s.b.data.pricePerGb.toFixed(3)} 元</>}
          </p>
        </li>
      ))
    }
  </ol>

  {/* 口径限定。既是诚实，也是被引用时会一并带走的限定语 */}
  <p class="m-0 mt-5 max-w-[44rem] text-[0.92rem] text-muted">
    <strong class="text-ink">以上不是速度排名。</strong>
    本站不做统一环境下的独立测速，这几家是「把可以核对的东西写清楚了」的品牌，
    值得你花一个月去验证，不代表一定最稳。全部为品牌与渠道口径，核对于 {LAST_SITE_UPDATE}。
    {nearlyRest > 0 && <>另有 {nearlyRest} 家同样满足专线与月付两项，见完整对照。</>}
  </p>

  <p class="m-0 mt-4 flex flex-wrap gap-x-6 gap-y-2">
    <a href="/best/stable/" class="text-[0.95rem]">三项指标的完整对照 →</a>
    <a href="/guides/stability-signals/" class="text-[0.95rem]">自己测的七天验证流程 →</a>
    <a href="/airport-ranking/" class="text-[0.95rem]">不受商业影响的计算型榜单 →</a>
  </p>
</section>
