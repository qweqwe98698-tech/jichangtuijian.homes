---
/** 品牌档案索引：数据行式列表（商业承接层入口）。 */
import { getCollection } from 'astro:content';
import Base from '@/layouts/Base.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import VerifyStamp from '@/components/VerifyStamp.astro';
import { breadcrumbSchema, webPageSchema, type Crumb } from '@/lib/schema';
import { LAST_SITE_UPDATE } from '@/lib/site';

const brands = (await getCollection('brands')).sort((a, b) => {
  const aHidden = a.data.dataStatus === 'unverified' || a.data.suppressIndex ? 1 : 0;
  const bHidden = b.data.dataStatus === 'unverified' || b.data.suppressIndex ? 1 : 0;
  if (aHidden !== bHidden) return aHidden - bHidden;
  const ap = a.data.editorialPick?.rank ?? 99;
  const bp = b.data.editorialPick?.rank ?? 99;
  if (ap !== bp) return ap - bp;
  return (a.data.pricePerGb ?? 99) - (b.data.pricePerGb ?? 99);
});
const tierLabel = { premium: '进阶 / 高端档', mid: '主流档', budget: '入门档' } as const;

const crumbs: Crumb[] = [
  { name: '首页', href: '/' },
  { name: '品牌档案', href: '/brands/' },
];

const pageDesc = `收录 ${brands.length} 家机场官网入口、起步价格、优惠码与风险状态，每项标注数据口径与核验状态。`;
---

<Base
  title="品牌档案：机场官网入口、价格与验证状态"
  description={pageDesc}
  schemaItems={[
    breadcrumbSchema(crumbs),
    webPageSchema({
      type: 'CollectionPage',
      name: '品牌档案：机场官网入口、价格与验证状态',
      description: pageDesc,
      path: '/brands/',
    }),
  ]}
>
  <div class="pt-6"><Breadcrumbs crumbs={crumbs} /></div>
  <div class="meta-text mt-3">全站档案口径同步于 {LAST_SITE_UPDATE}</div>

  <header class="mt-8 max-w-[46rem]">
    <h1 class="m-0 text-[1.8rem] sm:text-[2rem]">品牌档案</h1>
    <p class="m-0 mt-3 text-[1.05rem] text-muted">
      每个进入本站视野的品牌都有一页档案：结构化数据行、验证状态、风险等级、官方入口核验情况。
      档案页是全站唯一放置品牌外部入口的地方。
    </p>
  </header>

  <section class="mt-10 max-w-[52rem]" aria-label="品牌列表">
    {
      brands.map((b) => (
        <article class="border-b border-line py-6">
          <p class="meta-text m-0 flex flex-wrap items-center gap-3">
            <span>{tierLabel[b.data.tier]}</span>
            {b.data.priceFrom && <span>{b.data.priceFrom}</span>}
            {b.data.couponCode && <span class="text-amber">码 {b.data.couponCode}</span>}
            {b.data.lastVerified ? (
              <VerifyStamp status="sourced" date={b.data.lastVerified} />
            ) : (
              <VerifyStamp status="pending" />
            )}
          </p>
          <h2 class="m-0 mt-1 text-[1.3rem]">
            <a href={`/brands/${b.id}/`} class="text-ink hover:text-accent">
              {b.data.name}
            </a>
          </h2>
          <p class="m-0 mt-1 max-w-[44rem] text-[0.94rem] text-muted">{b.data.positioning}</p>
          <p class="m-0 mt-2 flex gap-4 text-[0.9rem]">
            <a href={`/brands/${b.id}/`}>档案 →</a>
            {b.data.reviewSlug && <a href={`/${b.data.reviewSlug}/`}>深度评测 →</a>}
          </p>
        </article>
      ))
    }
  </section>

  <p class="meta-text mt-10 max-w-[46rem] pb-6">
    收录 ≠ 推荐。档案数据按<a href="/data-sources/">数据来源政策</a>维护；
    部分品牌入口可能含推广合作，见<a href="/disclaimer/">免责声明</a>。
  </p>
</Base>
