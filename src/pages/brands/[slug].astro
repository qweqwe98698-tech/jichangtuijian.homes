---
/** 品牌档案页：数据行 + 图表 + 套餐优惠 + 风险 + 商业承接（全站唯一外部入口层）。 */
import { getCollection } from 'astro:content';
import Base from '@/layouts/Base.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import VerifyStamp from '@/components/VerifyStamp.astro';
import BrandCharts from '@/components/BrandCharts.astro';
import BrandPanelData from '@/components/BrandPanelData.astro';
import { breadcrumbSchema, webPageSchema, type Crumb } from '@/lib/schema';

export async function getStaticPaths() {
  const brands = await getCollection('brands');
  return brands.map((brand) => ({ params: { slug: brand.id }, props: { brand } }));
}

const { brand } = Astro.props;
const b = brand.data;
const tierLabel = { premium: '进阶档', mid: '主流档', budget: '入门档' } as const;
const riskLabel = { low: '低', medium: '中', high: '高', unknown: '未完成核查' } as const;
const cycleLabel = {
  monthly: '月付',
  quarterly: '季付',
  yearly: '年付摊算',
  unknown: '未标注',
} as const;
const externalUrl = b.affiliateUrl ?? b.officialUrl;

/**
 * FAQ 的 acceptedAnswer 会被生成式引擎整段摘走，所以数据缺失时必须换一句完整的话，
 * 不能让「起步套餐为待核验」「{空}。客户端配置方法见…」这类半截句子进入结构化数据。
 */
/** 数据齐全与数据缺失两种情况，各说各的话——不能一句说没核验、下一句说已核对 */
const verdictAnswer = b.priceFrom
  ? `${b.positioning}起步套餐为${b.priceFrom}。本站已核对其入口、价格与优惠码（渠道资料），但晚高峰、流媒体与 AI 解锁未做独立测试，建议先用最短周期套餐自行验证再决定是否长期使用。`
  : `${b.positioning}本站尚未取得该品牌可核对的套餐与价格资料，因此本页不给出具体数字，也不对它作出推荐或不推荐的判断。在补齐资料之前，请以官网信息为准。`;

const clientSentence = b.clients.length
  ? `${b.name}按品牌口径支持 ${b.clients.join('、')}。${
      b.claims.subscriptionImport ? '支持订阅导入第三方客户端（部分需联系在线客服获取）。' : ''
    }`
  : `${b.name}未在公开资料中说明支持哪些客户端，请以官网为准。`;

const faq = [
  {
    q: `${b.name}机场怎么样？值得买吗？`,
    a: verdictAnswer,
  },
  {
    q: `${b.name}官网入口怎么找？会不会有假网站？`,
    a: externalUrl
      ? `本页的入口按渠道资料核对后提供。机场行业普遍存在仿冒站点，请勿从搜索广告位或陌生群链接进入付款页；核对域名后再操作，并把可用入口保存到本地。`
      : `本站尚未核对该品牌的官方入口，因此本页不提供跳转链接。机场行业普遍存在仿冒站点，在拿到可核对的官方域名之前，请勿从搜索广告位或陌生群链接进入付款页。`,
  },
  {
    q: `${b.name}有优惠码吗？`,
    a: b.couponCode
      ? `渠道资料提供的优惠码为 ${b.couponCode}。${b.couponNote ?? ''}优惠随时可能调整，以结算页实际显示为准。`
      : `渠道资料中未提供固定优惠码，购买前可关注官网的活动公告。`,
  },
  {
    q: `${b.name}支持哪些客户端？`,
    a: `${clientSentence}客户端配置方法见本站 Clash 与 Shadowrocket 教程。`,
  },
  {
    q: `${b.name}适合买年付吗？`,
    a: `不建议首单年付。无论品牌口碑如何，机场行业的跑路风险决定了年付折扣本质上是用风险换的；先按最短周期验证一到两个月，通过后再考虑延长。`,
  },
];

const crumbs: Crumb[] = [
  { name: '首页', href: '/' },
  { name: '品牌档案', href: '/brands/' },
  { name: b.name, href: `/brands/${brand.id}/` },
];

const brandTaglines: Record<string, string> = {
  'dalaoyun': '官网入口、约5.6元小包与dly888优惠码',
  'ermao-yun': '官网与20元130GB套餐、ermao5555优惠码',
  'feimao-yun': '官网入口、约7元IEPL小包与flycat888优惠码',
  'firefly': '官网与8元IPLC专线套餐、firefly优惠码档案',
  'guangnian-ti': '官网入口、18元110GB套餐与gnt6666优惠码',
  'guangsu-yun': '官网入口、99元/年套餐与AMM优惠码技术档案',
  'huanqiuti': '官网、约5.6元入门套餐与HQ66优惠码档案',
  'jilian-yun': '官网入口、18元100GB套餐与ji8888优惠码',
  'kexin-yun': '官网入口、25元流媒体专线与kkk333优惠码',
  'kuaili': '官网入口、25元全能套餐与kkk2222优惠码',
  'lingmao-net': '官网与19元150GB月付套餐、lmao888优惠码',
  'liulianyun': '官网、约5.6元备用小包与ll88优惠码档案',
  'muguang-jiasu': '官网入口、20元IEPL套餐与muguang5555优惠码',
  'nexitally': '品牌资料、专线定位与官方入口核验状态',
  'quanqiu-yun': '官网与20元双解锁套餐、qqy7777优惠码档案',
  'shandianshu': '官网、约5.6元IEPL小包与sd88优惠码档案',
  'shanyue': '官网入口、24元企业内网套餐与shanyue优惠码',
  'shenxing-jiasu': '官网与约14元120GB套餐、xs0077优惠码档案',
  'sogo-yun': '官网入口、25元双全解锁套餐与sss777优惠码',
  'sujie': '官网与25元AI专线套餐、sss1111优惠码档案',
  'tiziyun': '官网入口、约7.4元专线小包与tiziyun优惠码',
  'u1s1': '官网与20元流媒体专线、akaka优惠码档案',
  'weifeng-wangluo': '官网入口、137元/年清风档、50节点面板图与flat888优惠码',
  'weitu-yun': '官网入口、14.9元/100GB月付、79.9元/年限量档与优惠码weitu666',
  'wgetcloud': '官网注册入口、297元/季Trojan专线与59节点历史测试档案',
  'wuyou-lianjie': '官网入口、79元/年MINI、19元月付、50节点流媒体原图与wuyou666',
  'xingdao-meng': '官网与96元/年贴心小包、多档不限时包及nmw888优惠码',
  'yifan-yun': '官网入口、20元150GB三协议大流量与yfy6666优惠码',
  'yinxingren': '官网与109元/年小包、24元月付及yxr888优惠码档案',
  'yunjiexian': '官网与约5.6元IEPL小包、yjx888优惠码档案',
  'yuzhou-yun': '官网入口、14.9元流媒体档、50节点面板图与YUZHOU553优惠码',
  baiyueguang: '官网入口、66元/季100GB档与79地区历史测试档案',
  flyingbird: '飞鸟机场套餐表、Shadowsocks专线与theo/year85优惠码',
  cyberguard: '官网入口、32元350GB大流量、半年95元与不限时流量包档案',
  'longmao-yun': '龙猫云套餐表、SS与IPLC专线及多周期折扣档案',
  fatcat: '肥猫云套餐表、96元/年加强版与企业级内网专线档案',
  tntcloud: 'TNTCloud原3A加速器、30元/季轻量包与TNT85优惠码档案',
  'qingyun-ti': '青云梯老牌团队、96元/年与qyt80八折优惠码档案',
  'shanshui-yun': '官网入口、15元100GB琴档、88元年付与27节点历史档案',
  'lingdong-yun': '官网入口、99元/年与20元月付、OpenAI全解锁档案',
  langwang: '浪网品牌资料与遮挡字段核验状态',
  edgenova: '官网入口、15元限时月付、多线路分配与TH888八折码',
  sslar: 'SSLAR企业IEPL与多线BGP、17元月付与ko3eTt0w优惠码',
};

const customDescriptions: Record<string, string> = {
  'weitu-yun': '唯兔云最新官网入口核验、14.9元/100GB限时月付（年付79.9元起）与优惠码weitu666，含10档完整套餐表、IPLC三网优化与60+节点参数档案。',
  'guangnian-ti': '光年梯官网入口核验、18元/月110GB套餐与优惠码gnt6666，收录IEPL专线、VLESS协议、63节点第三方导出数据与深度评测。',
  'feimao-yun': '飞猫云官网入口、84元/年（50GB/月）与25元月付星耀版价格及优惠码flycat888，附专属客户端说明与测速面板原图。',
  'jilian-yun': '极连云官网入口核验、18元/月100GB套餐与优惠码ji8888，收录IEPL专线、63节点面板延迟与AI工具口径档案。',
  'guangsu-yun': '光速云官网入口、99元/年（69GB/月）、147元/247GB永久包与优惠码AMM，含70节点VLESS解锁与三网入口6组面板原图。',
  'weifeng-wangluo': '微风网络官网入口、清风137元/年（100GB/月）与乘风27元月付全表、优惠码flat888，附50节点VLESS面板实拍图。',
  'wuyou-lianjie': '无忧链接官网入口、MINI 79元/年与19元月付全表、优惠码wuyou666，附50节点测速原图与NF/D+ 50/50全解锁面板原图。',
  firefly: 'Firefly（萤火虫）官网入口、96元/年与多周期Lite至Nova完整价格表、8折码firefly，及专属客户端使用提示。',
  wgetcloud: 'WgetCloud官网入口、297元/季（230GB/月）Trojan专线三档套餐表，附2026-05-02 59节点全区历史测速与AI/流媒体汇总。',
};

const pageTitle = `${b.name}${brandTaglines[brand.id] ?? `官网与参数档案：${b.positioning}`}`;
const pageH1 =
  b.dataStatus === 'unverified'
    ? `${b.name}品牌资料与官方入口核验状态`
    : `${b.name}官网入口、套餐价格与参数档案`;

const clampDesc = (s: string) => (s.length <= 74 ? s : `${s.slice(0, 72).replace(/[，。；、\s]+$/, '')}。`);
const autoDesc =
  b.dataStatus === 'unverified'
    ? `${b.name}品牌资料与核验状态：目前暂未完成官方入口与完整配额核查，仅记录公开宣传口径与风控提醒，下单前请自行核实。`
    : `${b.name}官网入口与参数核验：${b.priceFrom ?? '暂未定价'}${b.couponCode ? `，优惠码${b.couponCode}` : ''}。附完整套餐表、${b.lineTypes[0] ?? '线路口径'}与协议档案。`;
const pageDesc = customDescriptions[brand.id] ?? clampDesc(autoDesc);
---

<Base
  title={pageTitle}
  description={pageDesc}
  schemaItems={[
    breadcrumbSchema(crumbs),
    webPageSchema({
      type: 'WebPage',
      name: pageH1,
      description: pageDesc,
      path: `/brands/${brand.id}/`,
    }),
  ]}
  noindex={b.dataStatus === 'unverified' || b.suppressIndex}
>
  <div class="pt-6"><Breadcrumbs crumbs={crumbs} /></div>

  <div class="mt-8 grid gap-10 lg:grid-cols-12">
    <div class="lg:col-span-8" data-pagefind-body>
      <header>
        <p class="meta-text m-0 flex flex-wrap items-center gap-3">
          <span>{tierLabel[b.tier]}</span>
          {b.launchYear && <span>运营：{b.launchYear}</span>}
          <VerifyStamp status="sourced" date={b.lastVerified ?? undefined} />
          {
            b.editorialPick && (
              <a href="/airport-ranking/#picks-heading" class="stamp stamp-measured no-underline">
                本站主推 第 {b.editorialPick.rank} 位
              </a>
            )
          }
        </p>

        <h1 class="m-0 mt-2 text-[1.8rem] sm:text-[2rem]">{pageH1}</h1>
        <p class="m-0 mt-3 max-w-[42rem] text-[1.05rem]">{b.positioning}</p>

        {
          b.editorialPick && (
            <aside class="mt-5 max-w-[44rem] border-l-[3px] border-accent bg-surface p-4">
              <p class="meta-text m-0 tracking-widest">为什么把它放进主推位</p>
              <p class="m-0 mt-1.5 text-[0.95rem]">{b.editorialPick.reason}</p>
              <p class="m-0 mt-2 text-[0.92rem] text-muted">
                <strong class="text-ink">保留意见：</strong>
                {b.editorialPick.caveat}
              </p>
              <p class="meta-text m-0 mt-2">
                主推位是含商业合作的编辑选择，与<a href="/airport-ranking/">按维度计算的榜单</a>
                相互独立；本页的数据行与风险等级不受主推位影响。
              </p>
            </aside>
          )
        }
      </header>

      {/* 套餐与优惠：商业信息前置 */}
      <section class="mt-8 max-w-[44rem] border border-line bg-surface p-5">
        <div class="flex flex-wrap items-baseline gap-x-8 gap-y-3">
          <div>
            <p class="meta-text m-0 tracking-widest">起步套餐</p>
            <p class="m-0 font-display text-[1.3rem]">{b.priceFrom ?? '待核验'}</p>
            <p class="meta-text m-0">
              {cycleLabel[b.billingCycle]}
              {b.pricePerGb && ` · 约 ${b.pricePerGb.toFixed(3)} 元/GB`}
            </p>
          </div>
          {
            b.couponCode && (
              <div>
                <p class="meta-text m-0 tracking-widest">优惠码</p>
                <p class="m-0 font-display text-[1.3rem] text-amber">{b.couponCode}</p>
                <p class="meta-text m-0">{b.couponNote}</p>
              </div>
            )
          }
        </div>
        {b.priceBasis && <p class="m-0 mt-3 text-[0.9rem] text-muted">{b.priceBasis}</p>}
        {
          (b.paymentMethods?.length > 0 || b.clientNotes) && (
            <div class="mt-3 space-y-1 border-t border-line pt-3 text-[0.88rem] text-muted">
              {b.paymentMethods?.length > 0 && (
                <p class="m-0">
                  <strong class="text-ink">支付方式：</strong>
                  {b.paymentMethods.join(' · ')}
                </p>
              )}
              {b.clientNotes && (
                <p class="m-0">
                  <strong class="text-ink">客户端与订阅方式：</strong>
                  {b.clientNotes}
                </p>
              )}
            </div>
          )
        }
        <p class="meta-text m-0 mt-4 border-t border-line pt-3">
          {
            b.lastVerified
              ? `价格与优惠为渠道资料口径（核对于 ${b.lastVerified}），品牌方可随时调整，付款前请以官网结算页为准。`
              : '本站尚未核对该品牌的价格与优惠信息，本页不给出具体数字；请以官网结算页为准。'
          }
        </p>
      </section>

      {
        b.plans && b.plans.length > 0 && (
          <section class="mt-8 max-w-[46rem]">
            <h2 class="m-0 text-[1.35rem]">完整套餐价格表（渠道核对口径）</h2>
            <p class="meta-text m-0 mt-1">
              以下展开已知计费周期与流量包档位，折合单价仅按标称流量简单除算，未计入节点倍率与折扣叠加；结算请以官网当前页为准。
            </p>
            <div class="table-scroll mt-3">
              <table>
                <thead>
                  <tr>
                    <th scope="col">套餐名称</th>
                    <th scope="col">计费周期</th>
                    <th scope="col">价格</th>
                    <th scope="col">标称流量</th>
                    <th scope="col">发放方式</th>
                    <th scope="col">折合单价</th>
                    <th scope="col">说明</th>
                  </tr>
                </thead>
                <tbody>
                  {b.plans.map((p) => (
                    <tr>
                      <th scope="row" class="whitespace-nowrap">{p.name}</th>
                      <td class="whitespace-nowrap">{p.cycle}</td>
                      <td class="whitespace-nowrap font-display">{p.price}</td>
                      <td class="whitespace-nowrap">{p.traffic}</td>
                      <td class="whitespace-nowrap">{p.trafficCycle}</td>
                      <td class="whitespace-nowrap">{p.pricePerGb ?? '—'}</td>
                      <td class="min-w-[8rem] text-[0.86rem] text-muted">{p.note ?? '—'}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </section>
        )
      }

      {
        b.highlights.length > 0 && (
          <section class="mt-10 max-w-[44rem]">
            <h2 class="m-0 text-[1.35rem]">品牌主打卖点（宣传口径）</h2>
            <ul class="mt-3 grid gap-x-6 gap-y-2 sm:grid-cols-2">
              {b.highlights.map((h) => (
                <li class="text-[0.95rem]">{h}</li>
              ))}
            </ul>
          </section>
        )
      }

      <section class="mt-10 max-w-[44rem]">
        <h2 class="m-0 text-[1.35rem]">背景</h2>
        <p class="m-0 mt-2 text-[0.97rem] text-muted">{b.background}</p>
      </section>

      <section class="mt-10 max-w-[44rem]">
        <h2 class="m-0 mb-3 text-[1.35rem]">数据行</h2>
        <dl class="data-rows">
          {
            b.facts.map((f) => (
              <div class="data-row">
                <dt>{f.label}</dt>
                <dd class="flex flex-wrap items-baseline gap-2">
                  <span>{f.value}</span>
                  <VerifyStamp status={f.status} />
                  {f.note && <span class="meta-text">{f.note}</span>}
                </dd>
              </div>
            ))
          }
        </dl>
        <p class="meta-text m-0 mt-3">
          三种来源标记的含义见<a href="/data-sources/">数据来源政策</a>，核验流程见<a
            href="/methodology/">资料核验方法</a
          >：「第三方公开数据」有真实测量但非本站执行，「官方与渠道资料」为品牌公开说明，「暂无统一测试数据」表示该项没有可引用来源，本站不做统一环境下的独立测速。
        </p>
      </section>

      {
        b.thirdPartySummary && (
          <section class="mt-10 max-w-[46rem]">
            <h2 class="m-0 text-[1.35rem]">历史第三方测试汇总（{b.thirdPartySummary.testedAt}）</h2>
            <p class="meta-text m-0 mt-2">{b.thirdPartySummary.toolNote}</p>
            {b.thirdPartySummary.regions.length > 0 && (
              <div class="table-scroll mt-3">
                <table>
                  <thead>
                    <tr>
                      <th scope="col">地区 / 测试项</th>
                      <th scope="col">统计延迟</th>
                      <th scope="col">统计下载</th>
                    </tr>
                  </thead>
                  <tbody>
                    {b.thirdPartySummary.regions.map((r) => (
                      <tr>
                        <th scope="row" class="whitespace-nowrap">{r.region}</th>
                        <td class="whitespace-nowrap">{r.latency}</td>
                        <td class="whitespace-nowrap">{r.download}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            )}
            {b.thirdPartySummary.unlockNotes.length > 0 && (
              <ul class="mt-3 list-none space-y-1.5 p-0 text-[0.92rem] text-muted">
                {b.thirdPartySummary.unlockNotes.map((u) => (
                  <li class="border-l-2 border-amber pl-3">{u}</li>
                ))}
              </ul>
            )}
            <p class="meta-text m-0 mt-3 border-l-2 border-line pl-3">{b.thirdPartySummary.caveat}</p>
          </section>
        )
      }

      <BrandPanelData brand={b} />

      <BrandCharts brand={b} />

      <section class="mt-12 grid max-w-[44rem] gap-8 sm:grid-cols-2">
        <div>
          <h2 class="m-0 text-[1.15rem]">优势</h2>
          <ul class="mt-3 list-none space-y-2 p-0 text-[0.94rem]">
            {b.strengths.map((s) => <li class="border-l-[3px] border-accent pl-3">{s}</li>)}
          </ul>
        </div>
        <div>
          <h2 class="m-0 text-[1.15rem]">局限与保留意见</h2>
          <ul class="mt-3 list-none space-y-2 p-0 text-[0.94rem]">
            {b.limitations.map((s) => <li class="border-l-[3px] border-amber pl-3">{s}</li>)}
          </ul>
        </div>
      </section>

      <section class="mt-10 grid max-w-[44rem] gap-8 sm:grid-cols-2">
        <div>
          <h2 class="m-0 text-[1.15rem]">适合谁</h2>
          <ul class="mt-3 list-disc pl-5 text-[0.94rem]">
            {b.suitableFor.map((s) => <li>{s}</li>)}
          </ul>
        </div>
        <div>
          <h2 class="m-0 text-[1.15rem]">不适合谁</h2>
          <ul class="mt-3 list-disc pl-5 text-[0.94rem]">
            {b.notSuitableFor.map((s) => <li>{s}</li>)}
          </ul>
        </div>
      </section>

      <section class="mt-10 max-w-[44rem] border border-line bg-surface p-5">
        <h2 class="m-0 text-[1.15rem]">风险等级：{riskLabel[b.riskLevel]}</h2>
        <p class="m-0 mt-2 text-[0.93rem] text-muted">
          本站尚未对该品牌完成独立的运营状态核查，「未完成核查」不代表存在问题，也不构成安全担保。
          购买策略建议照旧：先按最短周期试用，账户内不留余额，付款前对照
          <a href="/risk/exit-scam-signals/">跑路信号清单</a>做一次核对。
        </p>
      </section>

      <section class="mt-10 max-w-[44rem]">
        <h2 class="m-0 text-[1.15rem]">套餐与官方入口</h2>
        <p class="m-0 mt-2 text-[0.95rem] text-muted">{b.pricingNote}</p>
        <p class="m-0 mt-4">
          {
            externalUrl ? (
              <a
                href={externalUrl}
                class="btn-solid"
                rel="nofollow sponsored noopener"
                target="_blank"
              >
                前往 {b.name} 官网注册
              </a>
            ) : (
              <span class="stamp stamp-pending">官方入口核验中，暂不提供外链</span>
            )
          }
        </p>
        <p class="meta-text m-0 mt-3">
          {externalUrl && '以上为推广链接，合作不改变本页数据与结论。'}
          谨防仿冒站点：请勿从搜索广告位或陌生群链接进入付款页，核对域名后再操作。
        </p>
      </section>

      <section class="rule-top mt-14 max-w-[44rem] pt-8">
        <h2 class="m-0 mb-5 text-[1.35rem]">关于{b.name}的常见问题</h2>
        <dl class="m-0">
          {
            faq.map((f) => (
              <div class="mb-5">
                <dt class="font-display text-[1.05rem]">{f.q}</dt>
                <dd class="m-0 mt-1 text-[0.95rem] text-muted">{f.a}</dd>
              </div>
            ))
          }
        </dl>
      </section>
    </div>

    <aside class="lg:col-span-4">
      <div class="flex flex-col gap-5 lg:sticky lg:top-6">
        {/* 侧栏随页面吸顶跟随，是全页停留最久的位置；转化入口放在最前 */}
        {
          externalUrl && (
            <div class="border border-line bg-surface p-4">
              <p class="meta-text m-0 tracking-widest">注册入口</p>
              {b.priceFrom && <p class="m-0 mt-2 font-display text-[1.1rem]">起步 {b.priceFrom}</p>}
              {b.couponCode && (
                <p class="m-0 mt-1 text-[0.92rem]">
                  优惠码{' '}
                  <strong class="font-display text-[1.02rem] text-amber">{b.couponCode}</strong>
                </p>
              )}
              <p class="m-0 mt-3">
                <a
                  href={externalUrl}
                  class="btn-solid btn-block"
                  rel="nofollow sponsored noopener"
                  target="_blank"
                >
                  前往 {b.name} 官网注册
                </a>
              </p>
              <p class="meta-text m-0 mt-2">推广链接 · 建议首单只买最短周期</p>
            </div>
          )
        }
        {
          b.reviewSlug && (
            <div class="border border-line p-4">
              <p class="meta-text m-0 tracking-widest">深度阅读</p>
              <p class="m-0 mt-2 text-[0.95rem]">
                <a href={`/${b.reviewSlug}/`}>阅读 {b.name} 完整评测 →</a>
              </p>
            </div>
          )
        }
        <div class="border border-line p-4">
          <p class="meta-text m-0 tracking-widest">交叉验证</p>
          <ul class="m-0 mt-2 list-none p-0 text-[0.92rem] leading-loose">
            <li><a href="/">2026 机场推荐总览</a></li>
            <li><a href="/best/stable/">稳定机场推荐候选标准</a></li>
            <li><a href="/airport-ranking/">在排行榜中横向比较</a></li>
            <li><a href="/brand-library/">在品牌库中筛选同档</a></li>
            <li><a href="/guides/stability-signals/">用稳定性清单自查</a></li>
            <li><a href="/risk/exit-scam-signals/">核对跑路风险信号</a></li>
          </ul>
        </div>
        <p class="meta-text m-0">
          本页含推广合作入口，合作不改变数据与结论，见<a href="/disclaimer/">免责声明</a>。
        </p>
      </div>
    </aside>
  </div>

  {/* 移动端底部常驻转化悬浮栏 */}
  {
    externalUrl && (
      <>
        <div class="h-16 md:hidden" aria-hidden="true" />
        <aside class="mobile-sticky-cta flex items-center justify-between gap-3 md:hidden" aria-label="快捷购买入口">
          <div class="min-w-0 flex-1">
            <p class="m-0 truncate font-display text-[0.95rem] font-bold text-ink">
              {b.name}
            </p>
            <p class="meta-text m-0 truncate text-[0.78rem]">
              起步 {b.priceFrom ?? '月付灵活'}
              {b.couponCode && ` · 券码 ${b.couponCode}`}
            </p>
          </div>
          <a
            href={externalUrl}
            class="btn-solid whitespace-nowrap px-4 py-2 text-[0.9rem]"
            rel="nofollow sponsored noopener"
            target="_blank"
          >
            前往官网 ➔
          </a>
        </aside>
      </>
    )
  }
</Base>
