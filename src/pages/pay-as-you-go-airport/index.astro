---
/** P2 专题：按量计费 / 不限时机场。资料中明确提供不限时套餐的品牌才进名单。 */
import Base from '@/layouts/Base.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import BrandPickList from '@/components/BrandPickList.astro';
import { breadcrumbSchema, faqSchema, webPageSchema, type Crumb } from '@/lib/schema';

const reasons: Record<string, string> = {
  'guangsu-yun':
    '提供「致敬斯诺克147」永久套餐（¥147 / 247GB 不过期，折合约 0.595 元/GB），原生稳定节点且不限设备。',
  cyberguard:
    '提供 220GB（¥79）与 840GB（¥188，折合 0.224 元/GB）两档一次性流量包，购买前需向官网核实具体有效期细则。',
  'ermao-yun': '提供 ¥99 / 100GB 不限时套餐，适合已有主力机场、只想低成本留一条 IEPL 专线冷备的用户。',
  'weitu-yun': '提供 100GB（¥100）、200GB（¥160）、500GB（¥340）三档永久不限时包，全线 1 倍流量不限设备。',
  'xingdao-meng':
    '提供 100GB（¥100）、300GB（¥300）、1TB（¥600）三档永久不限时套餐，颗粒度齐备且覆盖老牌 IEPL。',
  'wuyou-lianjie': '提供 100GB（¥108）与 300GB（¥298）永久不限时包，无倍率不限设备，适合低频出海与应急备线。',
  'yifan-yun': '提供 100GB（¥100）、250GB（¥200）、500GB（¥400）不限时包，三协议兼容便于路由分流备用。',
  firefly: '提供 ¥100 / 100GB 不限时档，适合已安装其专属端、需要低频应急流量的用户。',
};

const faq = [
  {
    q: '按量计费机场是什么意思？适合哪些人？',
    a: '按量计费指按流量包购买、不绑定月份，用完为止。它适合三类人：用量很低且不规律的人、需要长期留一个备用订阅的人、以及出差或短期出国临时使用的人。日常高频使用者按月付通常更划算。',
  },
  {
    q: '不限时机场真的永久有效吗？',
    a: '「不限时」指流量包本身不设过期时间，但它的有效性完全依赖品牌继续运营。机场跑路时，不限时套餐里的剩余流量和年付套餐里的剩余月份一样归零——所以它不是低风险选项，只是把风险从「时间」换成了「品牌存续」。',
  },
  {
    q: '按量计费和月付机场哪个好？',
    a: '算一笔账就清楚：把流量包价格换算成每 GB 单价，与月付套餐的每 GB 单价比较。按量计费的单价通常更高，你多付的是「不用担心月底清零」的灵活性。用量稳定的人为这份灵活性付费不划算。',
  },
  {
    q: '不限时流量包会不会被降速或限速？',
    a: '取决于品牌的具体规则，渠道资料中通常不会写明。购买前应当在用户中心或向客服确认三件事：是否限速、是否限设备数、是否限制特定节点（如流媒体或专线节点常有额外限制）。',
  },
  {
    q: '一次性流量包和永久套餐靠谱吗？',
    a: '结构本身是合理的商业模式，问题出在定价反常时。当一个「永久套餐」的价格低到无法覆盖长期带宽成本，它就不是产品而是收割信号——判断标准见跑路信号清单。',
  },
];

const crumbs: Crumb[] = [
  { name: '首页', href: '/' },
  { name: '按量计费机场', href: '/pay-as-you-go-airport/' },
];
---

<Base
  title="按量计费与不限时机场：适合谁，风险在哪"
  description="按量计费与不限时机场适合谁？对比不限时套餐的年化换算与资金敞口风险，列出在库支持按量不限时的可选品牌。"
  schemaItems={[
    breadcrumbSchema(crumbs),
    webPageSchema({
      type: 'CollectionPage',
      name: '按量计费与不限时机场',
      description: '按量计费与不限时流量包机场候选及风险说明',
      path: '/pay-as-you-go-airport/',
    }),
    faqSchema(faq),
  ]}
>
  <div class="pt-6"><Breadcrumbs crumbs={crumbs} /></div>

  <header class="mt-8 max-w-[48rem]">
    <h1 class="m-0 text-[1.8rem] sm:text-[2.2rem]">按量计费与不限时机场</h1>
    <div class="verdict">
      <p class="verdict-label m-0">先说结论</p>
      <p class="m-0 text-[1.02rem]">
        按量计费买的是<strong>灵活性</strong>，代价通常是更高的每 GB 单价； 不限时套餐买的是<strong
          >「不会月底清零」</strong
        >，代价是把风险从时间换成了品牌存续——
        机场跑路时，剩余流量和剩余月份一样归零。所以它适合低频与备用场景，
        <strong>不适合当成规避跑路风险的手段</strong>。
      </p>
    </div>
  </header>

  <section class="rule-top mt-14 pt-10" aria-labelledby="fit-heading">
    <h2 id="fit-heading" class="m-0 text-[1.5rem]">三种人适合按量，三种人不适合</h2>
    <div class="mt-6 grid gap-8 md:grid-cols-2">
      <div class="border-t-[3px] border-accent pt-4">
        <h3 class="m-0 font-display text-[1.12rem]">适合</h3>
        <ul class="mt-3 list-disc pl-5 text-[0.94rem] text-muted">
          <li>一年只用几次、用量极不规律的人</li>
          <li>需要常备一个备用订阅、平时不跑流量的人</li>
          <li>短期出差或临时需求，不想为整月付费的人</li>
        </ul>
      </div>
      <div class="border-t-[3px] border-amber pt-4">
        <h3 class="m-0 font-display text-[1.12rem]">不适合</h3>
        <ul class="mt-3 list-disc pl-5 text-[0.94rem] text-muted">
          <li>每天都用的日常用户（月付单价更低）</li>
          <li>把不限时当成「防跑路」手段的人（逻辑不成立）</li>
          <li>需要晚高峰稳定的重度用户（这类需求该看线路而非计费方式）</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="rule-top mt-14 pt-10" aria-labelledby="calc-heading">
    <h2 id="calc-heading" class="m-0 text-[1.5rem]">怎么算才知道划不划算</h2>
    <p class="m-0 mt-2 max-w-[46rem] text-[0.95rem] text-muted">
      别比总价，比每 GB 单价，再比风险敞口。三步就能得出结论：
    </p>
    <ol class="path-index mt-6 max-w-[46rem]">
      <li>
        <p class="m-0 font-display text-[1.05rem]">把流量包换算成每 GB 单价</p>
        <p class="m-0 mt-1 text-[0.93rem] text-muted">
          包价 ÷ 流量额度。拿它和<a href="/cheap-airport/">月付价格对照表</a>里的单价直接比。
        </p>
      </li>
      <li>
        <p class="m-0 font-display text-[1.05rem]">估算你的真实月用量</p>
        <p class="m-0 mt-1 text-[0.93rem] text-muted">
          如果月用量稳定在 50GB 以上，几乎可以确定月付更划算；低于 20GB 且不规律，按量才有优势。
        </p>
      </li>
      <li>
        <p class="m-0 font-display text-[1.05rem]">把一次性支出当作风险敞口看</p>
        <p class="m-0 mt-1 text-[0.93rem] text-muted">
          一个大流量包的支出可能相当于半年月付。问自己一句：这家机场明天消失，这笔钱我能接受吗？
          判断依据见<a href="/risk/exit-scam-signals/">跑路信号清单</a>。
        </p>
      </li>
    </ol>
  </section>

  <section class="rule-top mt-14 pt-10" aria-labelledby="list-heading">
    <h2 id="list-heading" class="m-0 text-[1.5rem]">在库品牌中明确提供不限时套餐的机场</h2>
    <p class="m-0 mt-2 max-w-[46rem] text-[0.95rem] text-muted">
      入选条件：最新渠道完整套餐表中<strong>明确列出一次性不限时流量包价格与额度</strong>。购买前务必在结算页核对是否限制节点、限速或存在隐性有效期。
    </p>
    <div class="table-scroll mt-5">
      <table>
        <thead>
          <tr>
            <th scope="col">机场</th>
            <th scope="col">代表不限时档</th>
            <th scope="col">一次性价格</th>
            <th scope="col">流量额度</th>
            <th scope="col">折合单价</th>
            <th scope="col">档案</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <th scope="row">CyberGuard</th>
            <td>840G 流量包</td>
            <td class="whitespace-nowrap">¥188（小包 ¥79/220G）</td>
            <td>840GB</td>
            <td class="whitespace-nowrap">0.224 元/GB</td>
            <td><a href="/brands/cyberguard/">详情 →</a></td>
          </tr>
          <tr>
            <th scope="row">光速云</th>
            <td>致敬斯诺克147永久套餐</td>
            <td class="whitespace-nowrap">¥147</td>
            <td>247GB</td>
            <td class="whitespace-nowrap">0.595 元/GB</td>
            <td><a href="/brands/guangsu-yun/">详情 →</a></td>
          </tr>
          <tr>
            <th scope="row">星岛梦</th>
            <td>永久不限时（100G / 300G / 1TB）</td>
            <td class="whitespace-nowrap">¥100 / ¥300 / ¥600</td>
            <td>100GB–1TB</td>
            <td class="whitespace-nowrap">0.600–1.000 元/GB</td>
            <td><a href="/brands/xingdao-meng/">详情 →</a></td>
          </tr>
          <tr>
            <th scope="row">微风网络</th>
            <td>信风 / 长风不限时</td>
            <td class="whitespace-nowrap">¥200 / ¥370</td>
            <td>270GB / 570GB</td>
            <td class="whitespace-nowrap">0.649–0.741 元/GB</td>
            <td><a href="/brands/weifeng-wangluo/">详情 →</a></td>
          </tr>
          <tr>
            <th scope="row">唯兔云</th>
            <td>永久不限时（100G / 200G / 500G）</td>
            <td class="whitespace-nowrap">¥100 / ¥160 / ¥340</td>
            <td>100GB–500GB</td>
            <td class="whitespace-nowrap">0.680–1.000 元/GB</td>
            <td><a href="/brands/weitu-yun/">详情 →</a></td>
          </tr>
          <tr>
            <th scope="row">一翻云</th>
            <td>不限时包（100G / 250G / 500G）</td>
            <td class="whitespace-nowrap">¥100 / ¥200 / ¥400</td>
            <td>100GB–500GB</td>
            <td class="whitespace-nowrap">0.800–1.000 元/GB</td>
            <td><a href="/brands/yifan-yun/">详情 →</a></td>
          </tr>
          <tr>
            <th scope="row">二猫云 / Firefly</th>
            <td>不限时 100GB 备线包</td>
            <td class="whitespace-nowrap">¥99 / ¥100</td>
            <td>100GB</td>
            <td class="whitespace-nowrap">0.990–1.000 元/GB</td>
            <td><a href="/brands/ermao-yun/">二猫 →</a></td>
          </tr>
        </tbody>
      </table>
    </div>
    <div class="mt-6">
      <BrandPickList
        slugs={['guangsu-yun', 'cyberguard', 'weitu-yun', 'xingdao-meng', 'ermao-yun', 'yifan-yun']}
        reasons={reasons}
        limit={6}
      />
    </div>
    <p class="meta-text mt-4">
      具体限速条款、多设备规则与可用节点范围以品牌用户中心最新公示为准；长期高用量仍建议选月付方案。
    </p>
  </section>

  <section class="rule-top mt-14 pt-10 pb-6" aria-labelledby="faq-heading">
    <h2 id="faq-heading" class="m-0 text-[1.5rem]">按量计费常见问题</h2>
    <dl class="m-0 mt-6 max-w-[46rem]">
      {
        faq.map((f) => (
          <div class="mb-6">
            <dt class="font-display text-[1.05rem]">{f.q}</dt>
            <dd class="m-0 mt-1 text-[0.95rem] text-muted">{f.a}</dd>
          </div>
        ))
      }
    </dl>
    <p class="meta-text m-0 mt-4">
      继续：<a href="/cheap-airport/">月付价格对照</a> ·
      <a href="/best/budget/">低价方案的代价清单</a> ·
      <a href="/brand-library/">全部品牌对照</a>
    </p>
  </section>
</Base>
