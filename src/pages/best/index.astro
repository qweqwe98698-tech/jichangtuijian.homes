---
/** 场景推荐 Hub：按场景组织，未完成的场景明示「研究中」，不放死链。 */
import { getCollection } from 'astro:content';
import Base from '@/layouts/Base.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import { breadcrumbSchema, webPageSchema, type Crumb } from '@/lib/schema';

const posts = await getCollection(
  'articles',
  ({ id, data }) => id.startsWith('best/') && !data.draft,
);
const bySlug = (slug: string) => posts.find((p) => p.id === `best/${slug}`);

interface ScenarioItem {
  slug: string;
  name: string;
  ask: string;
  href?: string;
  desc?: string;
}

const scenarios: ScenarioItem[] = [
  { slug: 'ai', name: 'AI 工具场景', ask: '要跑 ChatGPT / Claude / Gemini' },
  { slug: 'budget', name: '预算优先场景', ask: '想便宜，但不想踩坑' },
  { slug: 'stable', name: '稳定优先场景', ask: '晚高峰不能卡' },
  {
    slug: 'streaming',
    name: '流媒体场景',
    ask: '要看 Netflix / Disney+ / YouTube 4K',
    href: '/streaming-airport/',
    desc: '在库宣称流媒体解锁的品牌名单、每 GB 单价，以及原生 IP 与 DNS 解锁的分辨方法。',
  },
  { slug: 'premium', name: '高端进阶场景', ask: '预算 20–25 元以上或看重多设备与风控' },
  {
    slug: 'iplc',
    name: 'IEPL / IPLC 专线场景',
    ask: '关心晚高峰稳定韧性与真伪专线辨别',
    href: '/iepl-airport/',
    desc: '宣称使用 IEPL / 企业内网专线的候选与单价对照，附路由与晚高峰三步验证法。',
  },
];

const scenarioSlugs = new Set(scenarios.map((s) => s.slug));
const extraBest = posts
  .filter((p) => !scenarioSlugs.has(p.id.replace('best/', '')))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const crumbs: Crumb[] = [
  { name: '首页', href: '/' },
  { name: '场景推荐', href: '/best/' },
];
---

<Base
  title="场景推荐：按真实使用需求选机场"
  description="AI工具、稳定晚高峰、预算优先、流媒体与IEPL专线——按你的真实使用场景挑选在库机场与判定标准，告别主观第一。"
  schemaItems={[
    breadcrumbSchema(crumbs),
    webPageSchema({
      type: 'CollectionPage',
      name: '场景推荐',
      description: '按 AI、预算、稳定、流媒体、专线与高端进阶划分的机场选择指南',
      path: '/best/',
    }),
  ]}
>
  <div class="pt-6"><Breadcrumbs crumbs={crumbs} /></div>

  <header class="mt-8 max-w-[46rem]">
    <h1 class="m-0 text-[1.8rem] sm:text-[2rem]">场景推荐</h1>
    <p class="m-0 mt-3 text-[1.05rem] text-muted">
      「哪个机场最好」是个没有标准答案的问题；「哪个机场适合我的核心场景」才有解。盲目追逐所谓综合第一，往往会为了根本用不上的过剩冗余付出高昂月费。请先认领你的主力使用场景，再聚焦该场景下真正决定体验的核心技术指标。
    </p>
  </header>

  <section class="mt-8 max-w-[46rem] rounded-lg border border-line bg-surface p-6" aria-label="场景决策法则">
    <h2 class="m-0 text-[1.2rem] text-ink">场景匹配决策三要素</h2>
    <div class="mt-3 grid gap-4 sm:grid-cols-3 text-[0.93rem] text-muted">
      <div>
        <p class="m-0 font-semibold text-ink">1. 明确主要流量去向</p>
        <p class="m-0 mt-1">短视频与大容量下载重在「单价便宜与大带宽」；AI 问答与跨国会议重在「低丢包与专线稳定」。</p>
      </div>
      <div>
        <p class="m-0 font-semibold text-ink">2. 识别 IP 质量要求</p>
        <p class="m-0 mt-1">流媒体关注特定地区归属（Netflix/Disney+）；ChatGPT 与海外金融服务则严查风控欺诈值与原生住宅属性。</p>
      </div>
      <div>
        <p class="m-0 font-semibold text-ink">3. 评估使用终端环境</p>
        <p class="m-0 mt-1">全平台设备用户需确认通用订阅导入；iOS 新手或家庭长辈可优先考虑带有专属客户端的一键连接品牌。</p>
      </div>
    </div>
  </section>

  <section class="mt-10 max-w-[46rem]" aria-label="高频场景核心指标对照">
    <h2 class="m-0 text-[1.3rem]">高频场景技术指标与容错底线</h2>
    <div class="mt-4 overflow-x-auto">
      <table class="w-full text-left text-[0.92rem]">
        <thead>
          <tr class="border-b border-line text-ink">
            <th class="py-2 pr-4 font-semibold">使用场景</th>
            <th class="py-2 pr-4 font-semibold">决定性指标</th>
            <th class="py-2 pr-4 font-semibold">推荐网络架构</th>
            <th class="py-2 font-semibold">典型容错底线</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-line text-muted">
          <tr>
            <td class="py-2.5 pr-4 font-medium text-ink">AI / 大模型开发</td>
            <td class="py-2.5 pr-4">IP 纯净度、低欺诈值、支持长连接</td>
            <td class="py-2.5 pr-4">BGP 入口 + 纯净住宅/原生落地</td>
            <td class="py-2.5">频繁跳 Cloudflare 人机验证直接出局</td>
          </tr>
          <tr>
            <td class="py-2.5 pr-4 font-medium text-ink">晚高峰办公 / 证券</td>
            <td class="py-2.5 pr-4">20:30–22:30 低丢包（< 1%）、低抖动</td>
            <td class="py-2.5 pr-4">IPLC / IEPL 内网专线</td>
            <td class="py-2.5">公网直连中转拥塞直接出局</td>
          </tr>
          <tr>
            <td class="py-2.5 pr-4 font-medium text-ink">4K 流媒体观影</td>
            <td class="py-2.5 pr-4">单线程突发带宽（> 50Mbps）、非送中 IP</td>
            <td class="py-2.5 pr-4">大带宽中转 / 优化优质公网 BGP</td>
            <td class="py-2.5">仅解锁自制剧或地区锁区直接出局</td>
          </tr>
          <tr>
            <td class="py-2.5 pr-4 font-medium text-ink">备用 / 极低频轻量</td>
            <td class="py-2.5 pr-4">无到期时间、按量计费、极低月付门槛</td>
            <td class="py-2.5 pr-4">不过期流量包 / 季付小包</td>
            <td class="py-2.5">强制大额年付直接出局</td>
          </tr>
        </tbody>
      </table>
    </div>
  </section>

  <section class="mt-10" aria-label="场景列表">
    <h2 class="m-0 mb-4 text-[1.3rem]">进入细分场景专属指南</h2>
    <div class="grid gap-x-10 md:grid-cols-2">
      {
        scenarios.map((s) => {
          const post = bySlug(s.slug);
          const targetHref = s.href ?? (post ? `/${post.id}/` : '/guides/how-to-choose/');
          const targetDesc = s.desc ?? post?.data.description ?? '';
          return (
            <div class="border-t border-line py-5">
              <p class="meta-text m-0">{s.ask}</p>
              <h2 class="m-0 mt-1 text-[1.2rem]">
                <a href={targetHref} class="text-ink hover:text-accent">
                  {s.name}
                </a>
              </h2>
              <p class="m-0 mt-1 text-[0.92rem] text-muted">{targetDesc}</p>
              <p class="m-0 mt-2">
                <a href={targetHref} class="text-[0.93rem]">
                  {s.href ? '查看名单与标准 →' : '进入指南 →'}
                </a>
              </p>
            </div>
          );
        })
      }
    </div>
  </section>

  {
    extraBest.length > 0 && (
      <section class="mt-10 max-w-[46rem]" aria-label="更多场景专题推荐">
        <h2 class="m-0 mb-2 text-[1rem] tracking-widest text-muted">更多场景专栏</h2>
        <div class="grid gap-x-10 md:grid-cols-2">
          {extraBest.map((p) => (
            <div class="border-t border-line py-5">
              <h2 class="m-0 mt-1 text-[1.2rem]">
                <a href={`/${p.id}/`} class="text-ink hover:text-accent">
                  {p.data.title}
                </a>
              </h2>
              <p class="m-0 mt-1 text-[0.92rem] text-muted">{p.data.description}</p>
              <p class="m-0 mt-2">
                <a href={`/${p.id}/`} class="text-[0.93rem]">
                  进入指南 →
                </a>
              </p>
            </div>
          ))}
        </div>
      </section>
    )
  }

  <section class="rule-top mt-12 max-w-[46rem] pt-8 pb-6" aria-label="说明">
    <p class="m-0 text-[0.9rem] text-muted">
      场景指南只收录通过<a href="/methodology/">资料核验方法</a>核验或明确标注数据缺口的候选。
      拿到候选后，用<a href="/vs/">对比</a>做二选一，再进<a href="/reviews/">评测</a>看细节。
    </p>
  </section>
</Base>
